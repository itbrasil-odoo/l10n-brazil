<templates id="template" xml:space="preserve">

    <t
        t-name="l10n_br_pos.PaymentScreenPaymentLines"
        t-inherit="point_of_sale.PaymentScreenPaymentLines"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('delete-button')]" position="before">
            <button
                t-if="showCardData(line)"
                class="btn btn-link mx-1 px-2 js_l10n_br_card_data"
                t-on-click="() => this.editCardData(line)"
                title="Dados do cartão"
            >
                <i
                    class="fa fa-credit-card"
                    t-att-class="hasCardData(line) ? 'text-action' : 'text-muted'"
                />
            </button>
        </xpath>
    </t>

</templates>
