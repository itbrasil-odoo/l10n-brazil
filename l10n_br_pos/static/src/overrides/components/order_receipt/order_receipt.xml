<templates id="template" xml:space="preserve">

    <t
        t-name="l10n_br_pos.OrderReceiptBrPartner"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('before-footer')]" position="after">
            <t t-if="props.data.l10n_br_partner?.vat">
                <div class="pos-receipt-order-data">
                    <t t-esc="props.data.l10n_br_partner.vat_label or 'CNPJ/CPF'" />:
                    <t t-esc="props.data.l10n_br_partner.vat" />
                </div>
            </t>
        </xpath>
    </t>

</templates>
