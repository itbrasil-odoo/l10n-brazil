<odoo noupdate="1">
    <function model="l10n_br_fiscal.tax.group" name="write">
        <value
            eval="[
                ref('l10n_br_fiscal.tax_group_pis_wh'),
                ref('l10n_br_fiscal.tax_group_cofins_wh'),
            ]"
        />
        <value eval="{'generate_wh_invoice': True}" />
        <function
            eval="[{'allowed_company_ids': [ref('l10n_br_base.empresa_lucro_presumido')]}]"
            name="with_context"
        />
    </function>
</odoo>
